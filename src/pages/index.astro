---
const target = "/ko/";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://monave.app${target}`} />
    <title>Monave</title>
  </head>
  <body>
    <a href={target}>Redirecting to {target}</a>
  </body>
</html>
